# ======================================================
# ENVIRONMENT VARIABLES — Inventory System
# Salin file ini menjadi .env untuk development lokal.
# Untuk production (Helipod), set variabel-variabel ini
# langsung di dashboard Environment Variables Helipod.
# JANGAN commit file .env ke git.
# ======================================================

# -------------------------------------------------------
# SERVER
# -------------------------------------------------------
PORT=3000
NODE_ENV=production

# -------------------------------------------------------
# DATABASE — Pilih salah satu cara:
#
# CARA 1 (Direkomendasikan untuk cloud/Helipod):
#   Gunakan satu connection string DATABASE_URL.
#   Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/inventory_system
#
# CARA 2 (Development lokal / variabel terpisah):
#   Isi variabel DB_* di bawah, dan kosongkan DATABASE_URL.
# -------------------------------------------------------
DATABASE_URL=

DB_USER=postgres
DB_HOST=your-db-host.example.com
DB_NAME=inventory_system
DB_PASSWORD=your_db_password
DB_PORT=5432

# Set ke "false" hanya jika koneksi DB tidak menggunakan SSL.
# Untuk cloud database (Supabase, Neon, Railway, dll) biarkan kosong.
DB_SSL=

# -------------------------------------------------------
# JWT
# Gunakan string acak yang panjang dan tidak mudah ditebak.
# Generate contoh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -------------------------------------------------------
JWT_SECRET=ganti_dengan_secret_yang_kuat_dan_panjang
